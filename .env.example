API_PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=meowverse

# JWT (ต้องตั้งค่าก่อนรันจริง — สร้างค่าสุ่มได้ด้วย:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
# อายุของ token (หน่วย: m = นาที, h = ชั่วโมง, d = วัน)
# ใช้งานต่อเนื่องจะต่ออายุให้อัตโนมัติ แต่ต้อง login ใหม่อย่างน้อยทุก *_MAX_SESSION
# user ที่ไม่ได้ติ๊ก "จดจำฉัน"
JWT_EXPIRES_IN=12h
# user ที่ติ๊ก "จดจำฉัน"
JWT_REMEMBER_EXPIRES_IN=7d
# admin (ไม่สนใจ "จดจำฉัน")
JWT_ADMIN_EXPIRES_IN=12h
JWT_USER_MAX_SESSION=30d
JWT_ADMIN_MAX_SESSION=7d

# ถ้า API อยู่หลัง reverse proxy (nginx, Cloudflare ฯลฯ) ใส่จำนวน proxy ข้างหน้า เช่น 1
# เพื่อให้ rate limit เห็น IP จริงของผู้ใช้ (ถ้าไม่ได้ใช้ proxy ให้เว้นว่าง)
TRUST_PROXY=
