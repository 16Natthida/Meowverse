# Meowverse Phase 2.1 — QA Backend environment example
# EXAMPLE ONLY — NOT LOADED OR APPLIED
# Use only in an isolated QA workspace/process after approval.

NODE_ENV=test
HOST=127.0.0.1
API_PORT=3002
FRONTEND_ORIGIN=http://localhost:5174

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=<QA_DB_USER_WITH_ACCESS_ONLY_TO_MEOWVERSE_TEST>
DB_PASSWORD=<SET_VIA_NON_COMMITTED_SECRET_CHANNEL>
DB_NAME=meowverse_test

JWT_SECRET=<GENERATE_A_NEW_QA_ONLY_RANDOM_SECRET>
JWT_EXPIRES_IN=2h
JWT_REMEMBER_EXPIRES_IN=8h
JWT_ADMIN_EXPIRES_IN=2h
JWT_USER_MAX_SESSION=1d
JWT_ADMIN_MAX_SESSION=1d

TRUST_PROXY=

# The current source does NOT implement these proposed variables:
# QA_DISABLE_BACKGROUND_JOBS=true
# QA_UPLOADS_DIR=<ISOLATED_QA_WORKSPACE>\server\uploads
# Until source changes are separately approved, isolate uploads by running the
# QA backend from a separate workspace copy and design fixtures so startup jobs
# have no expired eligible rows.

